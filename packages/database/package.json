{
  "name": "@lab/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./job-repository": {
      "types": "./dist/repositories/job/job.repository.d.ts",
      "default": "./dist/repositories/job/job.repository.js"
    },
    "./job-query-repository": {
      "types": "./dist/repositories/job/job-query.repository.d.ts",
      "default": "./dist/repositories/job/job-query.repository.js"
    },
    "./membership-repository": {
      "types": "./dist/repositories/membership/membership.repository.d.ts",
      "default": "./dist/repositories/membership/membership.repository.js"
    },
    "./audit-query-repository": {
      "types": "./dist/repositories/audit/audit-query.repository.d.ts",
      "default": "./dist/repositories/audit/audit-query.repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node --env-file=../../.env dist/scripts/migrate.js",
    "seed": "node --env-file=../../.env dist/scripts/seed.js",
    "test:integration": "node --env-file=../../.env --test-concurrency=1 --test \"dist/repositories/**/*.integration.test.js\""
  },
  "dependencies": {
    "pg": "^8.16.0",
    "dotenv": "^17.0.0",
    "@lab/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
