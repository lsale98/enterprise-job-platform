{
  "name": "@lab/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./styles/ui.css": "./dist/styles/ui.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs && tailwindcss -i src/styles/index.css -o dist/styles/ui.css",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
