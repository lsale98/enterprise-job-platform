DATABASE_URL=postgres://USER:USER_PASS@localhost:5432/lab
TEST_DATABASE_URL=postgres://USER:USER_PASS@localhost:5432/lab_test
PORT=4000
NODE_ENV=development
JWT_INTERNAL_SECRET=replace-with-at-least-32-random-characters
API_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-different-32-character-random-secret
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=enterprise-job-platform-web
AUTH_KEYCLOAK_SECRET=replace-with-local-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/enterprise-job-platform
AUTH_API_AUDIENCE=enterprise-job-platform-api
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2:3b
AI_EMBED_MODEL=nomic-embed-text
OUTBOX_WEBHOOK_URL=http://127.0.0.1:4100/webhook
OUTBOX_WEBHOOK_SECRET=replace-with-long-random-secret-for-webhook-hmac